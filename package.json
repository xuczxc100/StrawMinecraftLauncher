{
  "name": "straw-minecraft-launcher",
  "productName": "StrawMinecraftLauncher",
  "version": "0.1.0-preview.1",
  "description": "StrawMinecraftLauncher (SMCL) - a cross-platform Minecraft Java Edition launcher built on XMCL core",
  "desktopName": "smcl.desktop",
  "author": "StrawCoding",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/xuczxc100/StrawMinecraftLauncher",
  "scripts": {
    "postinstall": "node scripts/fix-xmcl-packaging.mjs",
    "dev": "electron-vite dev",
    "build": "npm run sync-version && electron-vite build",
    "preview": "electron-vite preview",
    "sync-version": "node scripts/sync-version.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "SMCL_INTEGRATION=1 vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "check-version-bump": "bash scripts/check-version-bump.sh",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "overrides": {
    "@xmcl/yauzl": "2.10.0",
    "@xmcl/asm": "1.0.1",
    "@xmcl/system": "2.2.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "pinia": "^4.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@xmcl/core": "^2.16.2",
    "@xmcl/curseforge": "^2.2.2",
    "@xmcl/file-transfer": "^2.1.3",
    "@xmcl/installer": "^6.3.4",
    "@xmcl/mod-parser": "3.4.2",
    "@xmcl/modrinth": "^2.5.3",
    "@xmcl/unzip": "^2.2.0",
    "@xmcl/user": "^4.4.2",
    "@xmcl/yauzl": "2.10.0",
    "undici": "^7.30.0",
    "yazl": "^3.3.1"
  }
}
